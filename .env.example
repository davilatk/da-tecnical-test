# Copiar a .env. Valores de desarrollo local; no usar en otros entornos.

# Postgres (auth-service → auth_db, user-service → user_db)
POSTGRES_USER=toka
POSTGRES_PASSWORD=toka_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
AUTH_DATABASE_URL=postgresql://toka:toka_dev@localhost:5432/auth_db
USER_DATABASE_URL=postgresql://toka:toka_dev@localhost:5432/user_db

# MongoDB (audit-service → audit_db)
MONGO_USER=toka
MONGO_PASSWORD=toka_dev
MONGO_HOST=localhost
MONGO_PORT=27017
AUDIT_DB_NAME=audit_db
MONGODB_URI=mongodb://toka:toka_dev@localhost:27017/audit_db?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=toka
RABBITMQ_PASSWORD=toka_dev
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://toka:toka_dev@localhost:5672

# Qdrant
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Secretos de aplicación
JWT_SECRET=local-dev-jwt-secret-change-me
GEMINI_API_KEY=

# Puertos publicados por docker compose (opcionales; por defecto los de specs/00).
# WEB_CLIENT_PORT=80
# USER_SERVICE_PORT=3002
# AUDIT_SERVICE_PORT=3003
# AI_AGENT_SERVICE_PORT=8000
